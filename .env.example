# 火山引擎 API 密钥（必须填写）
ARK_API_KEY=your_api_key_here
ARK_IMAGE_TIMEOUT_MS=180000

# DeepSeek API 密钥（文案生成、文案改写、图文一体文案部分必须填写）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_VISION_TIMEOUT_MS=180000

# gpt-image-2 API（独立生图页使用，OpenAI 兼容接口）
XI_XU_API_BASE_URL=https://your-image-api.example
XI_XU_API_KEY=your_xi_xu_api_key_here
XI_XU_IMAGE_MODEL=gpt-image-2
XI_XU_VISION_MODEL=gpt-5.5
XI_XU_VISION_TIMEOUT_MS=180000
XI_XU_GENERATE_TIMEOUT_MS=0
XI_XU_GENERATE_RETRIES=1
XI_XU_EDIT_TIMEOUT_MS=0
XI_XU_EDIT_RETRIES=1
XI_XU_MAX_ACTIVE_JOBS=6
XI_XU_MAX_ACTIVE_JOBS_PER_USER=2
XI_XU_MAX_QUEUED_JOBS=20
XI_XU_IMAGE_RATE_LIMIT_PER_MIN=30
PROMPT_POLISH_RATE_LIMIT_PER_MIN=10
PROMPT_POLISH_MAX_CONCURRENT=6
PROMPT_POLISH_MAX_CONCURRENT_PER_USER=2
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_TOTAL_MB=40
MAX_UPLOAD_PIXELS=16000000
MAX_UPLOAD_TOTAL_PIXELS=24000000
MAX_SAVED_IMAGE_PIXELS=24000000

# JWT 登录密钥（生产环境必须使用高强度随机字符串）
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_COOKIE_SECURE=true
# 仅供需要 Bearer token 的旧 API 客户端；浏览器部署建议保持 false
AUTH_RETURN_TOKEN=false

# 初始管理员账号（首次启动创建管理员时使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# 允许的来源域名（生产环境使用，多个用逗号分隔，留空则允许所有同源请求）
# 示例: https://example.com 或 https://example.com,https://www.example.com
# ALLOWED_ORIGIN=https://your-domain.com
# 只有明确位于可信反向代理后方时才填写代理层数；直接对外监听时保持 0。
# nginx 与 Node 在同机、且 Node 只监听 127.0.0.1 时通常填写 1。
TRUST_PROXY_HOPS=1

# 生产环境必须显式为 false，禁止根据“看起来像内网 IP”自动放开注册。
LOCAL_REGISTER_WITHOUT_INVITE=false

# 普通用户邀请资格。生产默认建议关闭；开放时仍受每日、终身、未使用数量和账号年龄限制。
USER_INVITE_ENABLED=false
USER_INVITE_DAILY_LIMIT=3
USER_INVITE_LIFETIME_LIMIT=20
USER_INVITE_MAX_UNUSED=5
USER_INVITE_MIN_ACCOUNT_AGE_DAYS=1
USER_INVITE_MIN_POINTS_BALANCE=0
NEW_USER_BONUS_POINTS=1000

# 用户注册必须接受的政策版本；修改条款或隐私政策后同步更新前端常量。
POLICY_VERSION=2026-08-26-v1
# 正式上线前必须替换为真实信息。
OPERATOR_NAME=replace_with_legal_entity_name
SUPPORT_EMAIL=support@example.com
DATA_RETENTION_DAYS=30

# 服务端口（生产环境当前使用 3001，本地默认可用 3001）
# PORT=3001

# SQLite 在线备份保留天数；0 表示不自动清理旧备份
BACKUP_RETENTION_DAYS=30
UPLOAD_QUARANTINE_RETENTION_DAYS=30

# 仅用于本地/测试的模拟支付回调保护令牌。
# 生产环境不应使用模拟回调；如果临时开启 ENABLE_MOCK_PAYMENT=true，必须同时配置该令牌。
# ENABLE_MOCK_PAYMENT=false
# MOCK_PAYMENT_TOKEN=replace_with_a_long_random_token

# 支付对接状态展示（管理后台只展示是否配置，不会暴露密钥）
# mock 表示当前使用模拟二维码/管理员人工确认到账；接入真实支付前不要开启自动入账。
PAYMENT_PROVIDER=mock
# 用于生成支付平台回调地址，生产环境建议填写公网域名，例如 https://example.com
# PUBLIC_BASE_URL=https://your-domain.com

# 支付宝配置（真实接入时填写，回调地址：/api/payment/alipay/notify）
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=

# 微信支付配置（真实接入时填写，回调地址：/api/payment/wxpay/notify）
# WXPAY_APP_ID=
# WXPAY_MCH_ID=
# WXPAY_PRIVATE_KEY=
# WXPAY_API_V3_KEY=
